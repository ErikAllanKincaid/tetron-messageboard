[Unit]
Description=tetron-messageboard mesh-hosted message board
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tetron-messageboard run
Environment=TETRON_MESSAGEBOARD_PORT=__TETRON_MESSAGEBOARD_PORT__
Environment=TETRON_MESSAGEBOARD_NETWORK=__TETRON_MESSAGEBOARD_NETWORK__
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
